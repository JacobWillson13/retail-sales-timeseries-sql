# Copy this file to .env and fill in ONE block. Never commit or submit .env.

# --- Local Postgres (start here) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=retail
PGUSER=postgres
PGPASSWORD=your_local_password
PGSSLMODE=disable

# --- Azure Database for PostgreSQL (later) ---
# PGHOST=your-server-name.postgres.database.azure.com
# PGPORT=5432
# PGDATABASE=retail
# PGUSER=your_admin_user
# PGPASSWORD=your_password
# PGSSLMODE=require
